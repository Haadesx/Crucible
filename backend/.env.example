APP_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MUTATION_MODEL=gpt-4.1
AGENT_PROVIDER=fake
MUTATION_PROVIDER=deterministic

# --- Real co-evolution model endpoints (BuildProduct.md §6, §7) ---
# RED runs on the Linux ai-rig: llama.cpp on 100.116.103.79:8080, fronted by the
# ai-rig router on :11500 (RTX 5090, 128K context). Reach it over the private Tailscale
# address. The bearer key lives at ~/.config/airig/key on the Mac and is never committed.
# Export it for a run, e.g.  RED_API_KEY="$(cat ~/.config/airig/key)"
RUN_MODE=DEV
RED_PROVIDER=openai_compatible
RED_BASE_URL=http://ai-rig.tail6d5242.ts.net:11500/v1
RED_API_KEY=
RED_MODEL=qwen3.8-flash-next-heretic2

# BLUE is the defending agent in executor and harness-engineer roles.
# The executor and the harness-patch engineer are separate roles.
#   BLUE_MODEL          — the executor that plays episodes (Ling 3.0 Flash Fin).
#   BLUE_ENGINEER_MODEL — the HarnessPatch engineer (Nemotron 3 Super: native JSON mode,
#                         5/5 first-pass in the 2026-09-26 bake-off).
#   BLUE_FALLBACK_MODEL — used only when the engineer fails outright (transport,
#                         unavailable, rate limit after bounded retry, unusable output
#                         after repairs). Ling is known to reject response_format, so its
#                         requests skip that unsupported feature entirely.
BLUE_PROVIDER=openrouter
BLUE_BASE_URL=https://openrouter.ai/api/v1
BLUE_MODEL=inclusionai/ling-3.0-flash-fin:free
BLUE_ENGINEER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
BLUE_FALLBACK_MODEL=inclusionai/ling-3.0-flash-fin:free
OPENROUTER_API_KEY=

# Deterministic stand-ins are permitted ONLY when this is true (§5, §33).
# A real experiment must leave it false; `python -m app.audit_runtime` reports MOCK when set.
TEST_MODE=false

# Where run reports and training exports are written.
EXPORT_DIR=exports

MONGODB_URI=
MONGODB_DATABASE=darwinguard
# Persistence backend. "dev" is the labelled local backend (durable snapshot or
# in-memory). "atlas" requires a real MongoDB Atlas URI, an embedding-provider key and
# the two Atlas Vector Search indexes; the REAL runtime refuses to fall back otherwise.
# See docs/ATLAS_PERSISTENCE.md for the index definitions and verification commands.
PERSISTENCE=dev
# Optional durable DEV snapshot, used when Atlas is unavailable.
DEV_STATE_PATH=.dev-state.json
# Embeddings for Atlas Vector Search. OPENAI_API_KEY takes precedence; when it is absent
# the OpenRouter key is used (OpenRouter serves embedding models through /embeddings even
# though they are not listed in /models). Output dimensions must match the Atlas vector
# index: a non-OpenAI model such as baai/bge-m3 returns 1024, so change both
# EMBEDDING_DIMENSIONS and the index.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

RED_POPULATION=6
BLUE_POPULATION=6
GENERATIONS=5
MATCHUPS_PER_GENOME=3
MAX_PARALLEL_EPISODES=4

USE_VECTOR_SEARCH=true
USE_CHANGE_STREAMS=true
USE_SECONDARY_VERIFIER=false
USE_OPENROUTER=false
USE_VOICE=false
DEMO_MODE=false
